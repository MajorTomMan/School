      "blocks": [
        {
          "type": "historical_note",
          "text": "《九章算术》“方程”章给出了“正负术”。教材先用现代有理数加法解释其中后四句话：异名相除对应异号两数相加，同名相益对应同号两数相加，正无入正之、负无入负之对应0与正数或负数相加。"
        },
        {
          "type": "formula",
          "expression": "(+5)+(−3)=+(5−3)，(−5)+(+3)=−(5−3)",
          "conditions": [
            "异号两数相加"
          ]
        },
        {
          "type": "formula",
          "expression": "(+5)+(+3)=+(5+3)，(−5)+(−3)=−(5+3)",
          "conditions": [
            "同号两数相加"
          ]
        }
      ]
