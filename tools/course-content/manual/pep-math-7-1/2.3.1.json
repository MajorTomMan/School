  "pages": [
    {
      "id": "2.3.1-definition",
      "type": "lesson",
      "title": "从重复乘法引入乘方",
      "sourcePage": 51,
      "sourceAnchors": [
        {
          "page": 51,
          "text": "这种求n个相同乘数的积的运算，叫作乘方"
        }
      ],
      "blocks": [
        {
          "type": "textbook_text",
          "text": "若正方形边长为2cm，它的面积是2×2；正方体棱长为2cm，它的体积是2×2×2。为了简洁表示多个相同乘数相乘，教材引入乘方。"
        },
        {
          "type": "textbook_text",
          "text": "一般地，n个相同乘数a相乘，即a×a×…×a，记作a^n。这种求n个相同乘数的积的运算叫作乘方，乘方的结果叫作幂。在a^n中，a叫作底数，n叫作指数。"
        },
        {
          "type": "formula",
          "expression": "a^n=a×a×…×a",
          "conditions": [
            "共有n个因数a",
            "n为正整数"
          ]
        },
        {
          "type": "explanation",
          "text": "指数说明相同因数出现多少次，底数说明每个因数是什么。a^n既可以读作“a的n次方”，也可以读作“a的n次幂”。"
        },
        {
          "type": "visualization",
          "renderer": "power_process",
          "params": {
            "title": "指数控制重复因数的个数"
          }
        }
      ]
    },
    {
      "id": "2.3.1-negative-base",
      "type": "lesson",
      "title": "负数作底数时必须保留括号",
      "sourcePage": 51,
      "sourceAnchors": [
        {
          "page": 51,
          "text": "一个数可以看作这个数本身的一次方"
        }
      ],
      "blocks": [
        {
          "type": "textbook_text",
          "text": "一个数可以看作这个数本身的一次方，例如5=5^1。负数或分数作底数时要用括号明确底数整体，例如(−2)^4、(−2/3)^3。"
        },
        {
          "type": "explanation",
          "text": "(−2)^4表示四个−2相乘；而−2^4表示先计算2^4，再在结果前取负号。括号会改变底数，因此不能省略。"
        },
        {
          "type": "formula",
          "expression": "(−2)^4=16，−2^4=−16"
        },
        {
          "type": "conclusion",
          "text": "看到负号和乘方同时出现时，先判断负号是否属于底数。"
        }
      ]
    },
    {
      "id": "2.3.1-example-1",
      "type": "lesson",
      "title": "例1：计算有理数的乘方",
      "sourcePage": 52,
      "sourceAnchors": [
        {
          "page": 52,
          "text": "例1计算：（1）（−4）3"
        }
      ],
      "blocks": [
        {
          "type": "worked_example",
          "label": "例1",
          "statement": "计算：（1）(−4)^3；（2）(−2)^4；（3）(2/3)^3；（4）(−1.5)^2。",
          "steps": [
            "（1）(−4)^3=(−4)×(−4)×(−4)=−64。",
            "（2）(−2)^4=(−2)×(−2)×(−2)×(−2)=16。",
            "（3）(2/3)^3=2/3×2/3×2/3=8/27。",
            "（4）(−1.5)^2=(−1.5)×(−1.5)=2.25。"
          ],
          "result": "−64，16，8/27，2.25"
        },
        {
          "type": "conclusion",
          "text": "乘方本质仍是乘法；展开相同因数后，有理数乘法的符号法则照常适用。"
        }
      ]
    },
    {
      "id": "2.3.1-sign-parity",
      "type": "lesson",
      "title": "负数的奇次幂与偶次幂",
      "sourcePage": 52,
      "sourceAnchors": [
        {
          "page": 52,
          "text": "负数的奇次幂是负数，负数的偶次幂是正数"
        }
      ],
      "blocks": [
        {
          "type": "textbook_text",
          "text": "根据有理数乘法中多个非零因数的符号规律：负数的奇次幂是负数，负数的偶次幂是正数。"
        },
        {
          "type": "list",
          "items": [
            "(−a)^(奇数)<0（a>0）。",
            "(−a)^(偶数)>0（a>0）。",
            "1的任何正整数次幂都是1。",
            "−1的奇次幂是−1，偶次幂是1。"
          ]
        },
        {
          "type": "explanation",
          "text": "指数的奇偶决定负因数的个数是奇数还是偶数，因此直接决定积的符号。"
        },
        {
          "type": "visualization",
          "renderer": "power_process",
          "params": {
            "title": "指数奇偶决定负底数幂的符号"
          }
        }
      ]
    },
