      "sourcePage": 41,
      "sourcePageEnd": 42,
      "sourceAnchors": [
        {
          "page": 41,
          "text": "例3（1）计算2×3×0.5×（−7）"
        },
        {
          "page": 42,
          "text": "比较解法1与解法2，它们在运算顺序上有什么区别"
        }
      ],
      "blocks": [
        {
          "type": "worked_example",
          "label": "例3",
          "statement": "（1）计算2×3×0.5×(−7)；（2）用两种方法计算(1/4+1/6−1/2)×12。",
          "steps": [
            "（1）利用交换律、结合律：(2×0.5)×[3×(−7)]=1×(−21)=−21。",
            "（2）解法1先算括号：(1/4+1/6−1/2)=−1/12，再乘12得到−1。",
            "（2）解法2用分配律：1/4×12+1/6×12−1/2×12=3+2−6=−1。"
          ],
          "result": "两种方法都得−1；遇到合适的分母时，分配律往往更简便。"
        }
      ]
    },
